{
  "manifest_version": 3,
  "name": "Aura — AI Writing Assistant",
  "version": "1.0.0",
  "description": "AI-powered writing clarity, tone, and grammar suggestions in real time.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
